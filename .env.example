# ============================================================
# VARIABLES DE ENTORNO — RAW INGESTION PIPELINE
# Copia este archivo como .env y completa los valores
# ============================================================

# ---- Entorno ------------------------------------------------
ENV=development          # development | production

# ---- Rutas base --------------------------------------------
PROJECT_ROOT=.           # Raíz del proyecto (relativa o absoluta)
DATA_ROOT=./data         # Directorio raíz de datos

# ---- API MEF -----------------------------------------------
MEF_API_BASE=https://api.datosabiertos.mef.gob.pe/DatosAbiertos/v1
MEF_API_KEY=            # Opcional: si la API requiere key en el futuro

# ---- HTTP --------------------------------------------------
HTTP_TIMEOUT=120         # Segundos de timeout por request
HTTP_MAX_RETRIES=3       # Número máximo de reintentos
HTTP_BACKOFF_FACTOR=2    # Factor de espera entre reintentos (segundos)

# ---- Paginación CKAN ----------------------------------------
CKAN_PAGE_LIMIT=500    # Registros por página CKAN

# ---- Logging ------------------------------------------------
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=./logs           # Directorio de logs
